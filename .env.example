# Copy to .env (git-ignored). Never commit real keys.

# Path to the extracted KuaiRand-Pure data directory.
KUAIRAND_DATA_DIR=./KuaiRand-Pure/data

# LLM provider credentials for the autonomous agent (Nandit tracks token usage)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Agent run budget guards
AGENT_MAX_ITERATIONS=50
AGENT_MAX_WALL_CLOCK_HOURS=6
